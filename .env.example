# Goum site config (used by make / docker compose / Apache deploy)

# Public domain (no www.)
DOMAIN=goum.eu

# Full public URL (optional; defaults to https://$DOMAIN)
SITE_URL=https://goum.eu

# Host port published by Docker (Apache proxies to 127.0.0.1:$HTTP_PORT)
HTTP_PORT=8090

# Bind for local `make start` (0.0.0.0). Deploy forces 127.0.0.1.
HTTP_BIND=0.0.0.0

# Public contact (site + Let's Encrypt)
CONTACT_MAIL=admin@rootsolve.org
CONTACT_PHONE=06 66 66 66 66

# Optional YouTube channel (header link; omit or leave empty to hide)
YOUTUBE_URL=https://www.youtube.com/@GOUM-Music

# Set to 1 while testing DNS / rate limits
CERTBOT_STAGING=0
